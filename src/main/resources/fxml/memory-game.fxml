<?xml version="1.0" encoding="UTF-8"?>
<?import com.escontrela.lastmove.ui.component.board.ChessBoardControl?>
<?import com.escontrela.lastmove.ui.component.header.ApplicationHeader?>
<?import com.escontrela.lastmove.ui.component.message.MessageBox?>
<?import com.escontrela.lastmove.ui.component.training.MemoryPiecePickerControl?>
<?import com.escontrela.lastmove.ui.component.toolbar.ToolbarIconButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" styleClass="app-shell, progressive-game-shell, memory-game-shell" stylesheets="@../css/lastmove.css" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.escontrela.lastmove.ui.controller.MemoryGameScreenController">
  <BorderPane>
    <top><ApplicationHeader /></top>
    <center>
      <HBox spacing="16.0" styleClass="analysis-workspace, progressive-game-workspace"><padding><Insets bottom="16.0" left="20.0" right="20.0" top="8.0" /></padding>
        <StackPane alignment="CENTER" HBox.hgrow="ALWAYS"><ChessBoardControl fx:id="chessBoard" accessibleText="Memory training chess board" /></StackPane>
        <VBox prefWidth="300.0" spacing="14.0" styleClass="board-side-panel, progressive-game-side-panel, memory-game-side-panel">
          <VBox spacing="8.0" styleClass="progressive-player-zone, memory-game-status-card">
            <Label fx:id="phaseLabel" styleClass="eyebrow-label" text="Ready" />
            <Label styleClass="memory-stat-caption" text="TIME LEFT" />
            <Label fx:id="globalClockLabel" accessibleText="Global time remaining" styleClass="memory-global-clock" text="3:00" />
            <HBox spacing="8.0">
              <VBox spacing="3.0" styleClass="memory-stat-tile" HBox.hgrow="ALWAYS"><Label styleClass="memory-stat-caption" text="MEMORIZE" /><Label fx:id="memorizationClockLabel" accessibleText="Memorization time remaining" styleClass="memory-stat-value" text="0:05" /></VBox>
              <VBox spacing="3.0" styleClass="memory-stat-tile" HBox.hgrow="ALWAYS"><Label styleClass="memory-stat-caption" text="SCORE" /><Label fx:id="scoreLabel" accessibleText="Current score" styleClass="memory-stat-value" text="0/0" /></VBox>
            </HBox>
            <HBox spacing="8.0">
              <Label fx:id="difficultyLabel" maxWidth="Infinity" styleClass="memory-meta-chip" text="—" HBox.hgrow="ALWAYS" />
              <Label fx:id="attemptLabel" accessibleText="Current attempt" maxWidth="Infinity" styleClass="memory-meta-chip" text="Attempt 1" HBox.hgrow="ALWAYS" />
            </HBox>
          </VBox>
          <VBox fx:id="resultPanel" managed="false" visible="false" spacing="6.0" styleClass="memory-result-card">
            <Label styleClass="eyebrow-label" text="Session result" />
            <Label fx:id="resultScoreLabel" accessibleText="Success rate" styleClass="memory-result-score" text="0%" />
            <Label fx:id="resultVerdictLabel" accessibleText="Session verdict" styleClass="memory-result-verdict" text="Not passed" />
            <Label fx:id="resultDetailLabel" accessibleText="Points earned" styleClass="card-copy" wrapText="true" text="Points: 0 of 0" />
            <Button fx:id="playAgainButton" accessibleText="Play again" managed="false" onAction="#playAgain" styleClass="primary-button" text="Play again" visible="false" />
          </VBox>
          <Region VBox.vgrow="ALWAYS" />
          <HBox alignment="CENTER" spacing="8.0">
            <ToolbarIconButton fx:id="resetButton" accessibleText="Reset training session" darkIconResource="/images/refresh_35dp_FFFFFF.png" lightIconResource="/images/refresh_35dp_FFFFFF.png" maxWidth="Infinity" onAction="#resetSession" prefWidth="106.0" styleClass="arena-action-button, progressive-game-action, progressive-danger-action-button" text="Reset" tooltipText="Reset training session" HBox.hgrow="ALWAYS" />
            <ToolbarIconButton fx:id="soundToggleButton" accessibleText="Turn sound off" darkIconResource="/images/stop_35dp_FFFFFF.png" lightIconResource="/images/stop_35dp_000000.png" maxWidth="Infinity" onAction="#toggleSound" prefWidth="106.0" styleClass="arena-action-button, progressive-game-action, memory-sound-action-button" text="Sound off" tooltipText="Turn sound off" HBox.hgrow="ALWAYS" />
          </HBox>
          <Label fx:id="statusLabel" accessibleText="Training status" styleClass="status-text" wrapText="true" />
        </VBox>
      </HBox>
    </center>
    <bottom><HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="status-rail"><Label styleClass="eyebrow-label" text="Training Memory" /><Label styleClass="status-text" text="Memorize each position, then rebuild the hidden pieces." /></HBox></bottom>
  </BorderPane>
  <MemoryPiecePickerControl fx:id="piecePicker" />
  <MessageBox fx:id="exitConfirmation" />
</StackPane>
