<?xml version="1.0" encoding="UTF-8"?>
<?import com.escontrela.lastmove.ui.component.header.ApplicationHeader?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="root" styleClass="app-shell" stylesheets="@../css/lastmove.css" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.escontrela.lastmove.ui.controller.KnightshadeArenaScreenController">
  <BorderPane styleClass="app-shell"><top><ApplicationHeader/></top><center><ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="arena-scroll-pane"><content><VBox spacing="18" styleClass="studies-workspace"><padding><Insets top="28" right="44" bottom="40" left="44"/></padding>
    <VBox spacing="5"><Label text="Knightshade Arena" styleClass="catalog-title"/><Label text="Play and monitor your Lichess bot games." styleClass="catalog-support"/></VBox>
    <HBox spacing="12" styleClass="arena-summary"><VBox spacing="4"><Label text="Connection" styleClass="eyebrow-label"/><Label fx:id="connectionLabel" accessibleText="Arena connection status" text="DISCONNECTED" styleClass="arena-state"/></VBox><VBox spacing="4"><Label text="Account" styleClass="eyebrow-label"/><Label fx:id="accountLabel" accessibleText="Configured Lichess bot account" text="Configured bot account" styleClass="status-text"/></VBox><VBox spacing="4"><Label text="Active games" styleClass="eyebrow-label"/><Label fx:id="capacityLabel" accessibleText="Active Arena games out of configured maximum" text="0 / configured" styleClass="status-text"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="connectButton" accessibleText="Connect Knightshade Arena" text="Connect" onAction="#connect" styleClass="primary-button"/><Button fx:id="disconnectButton" accessibleText="Disconnect Knightshade Arena" text="Disconnect" onAction="#disconnect" styleClass="secondary-button"/></HBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS"><VBox spacing="8" HBox.hgrow="ALWAYS"><Label text="Challenges" accessibleHelp="Pending and decided Lichess challenges" styleClass="sessions-section-title"/><ListView fx:id="challengesList" VBox.vgrow="ALWAYS" styleClass="study-library-list"/></VBox><VBox spacing="8" HBox.hgrow="ALWAYS"><Label text="Games" accessibleHelp="Double-click a finished game to open analysis" styleClass="sessions-section-title"/><ListView fx:id="gamesList" onMouseClicked="#openSelectedGame" VBox.vgrow="ALWAYS" styleClass="study-library-list"/></VBox><VBox spacing="8" prefWidth="310"><Label text="Recent activity" styleClass="sessions-section-title"/><ListView fx:id="activityList" VBox.vgrow="ALWAYS" styleClass="study-library-list"/></VBox></HBox>
  </VBox></content></ScrollPane></center><bottom><HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-rail"><Label text="Status" styleClass="eyebrow-label"/><Label fx:id="statusLabel" text="Arena ready" styleClass="status-text"/></HBox></bottom></BorderPane>
</StackPane>
