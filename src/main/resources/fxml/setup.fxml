<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import com.escontrela.lastmove.ui.component.toolbar.ToolbarIconButton?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="app-shell" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.escontrela.lastmove.ui.controller.SetupScreenController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="workspace-header">
            <VBox spacing="6.0">
                <Label styleClass="eyebrow-label" text="Application preferences" />
                <Label styleClass="app-title" text="Setup" />
                <Label styleClass="hero-support" text="Choose how LastMove looks while you study your games." wrapText="true" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                <Button fx:id="applyButton" managed="false" mnemonicParsing="false" onAction="#applySettings" styleClass="message-box-button message-box-accept-button" text="Apply" visible="false" />
                <ToolbarIconButton accessibleText="Back to main window" lightIconResource="/images/back_35dp_000000.png" darkIconResource="/images/back_35dp_FFFFFF.png" tooltipText="Back" onAction="#backToMain" />
            </HBox>
        </HBox>
    </top>
    <center>
        <VBox alignment="TOP_LEFT" spacing="24.0" styleClass="setup-content">
            <padding><Insets bottom="64.0" left="80.0" right="80.0" top="64.0" /></padding>
            <VBox maxWidth="680.0" spacing="16.0" styleClass="setup-card">
                <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
                <Label styleClass="eyebrow-label" text="Appearance" />
                <Label styleClass="card-title" text="Night mode" />
                <Label styleClass="card-copy" text="Use the dark LastMove workspace across every screen. This preference is saved for your next session." wrapText="true" />
                <CheckBox fx:id="nightModeCheckBox" mnemonicParsing="false" styleClass="settings-check-box" text="Enable night mode" />
                <Label styleClass="card-title" text="Startup" />
                <Label styleClass="card-copy" text="Show the LastMove welcome screen when the application starts. This preference is saved for your next session." wrapText="true" />
                <CheckBox fx:id="showSplashCheckBox" mnemonicParsing="false" styleClass="settings-check-box" text="Show splash screen on startup" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
