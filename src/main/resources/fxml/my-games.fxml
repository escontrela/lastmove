<?xml version="1.0" encoding="UTF-8"?>
<?import com.escontrela.lastmove.ui.component.context.ContextualMenuPanel?>
<?import com.escontrela.lastmove.ui.component.header.ApplicationHeader?>
<?import com.escontrela.lastmove.ui.component.search.RegexSearchControl?>
<?import com.escontrela.lastmove.ui.component.tag.TagFilterControl?>
<?import com.escontrela.lastmove.ui.component.player.PlayerSelectorModal?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane fx:id="root" styleClass="app-shell" stylesheets="@../css/lastmove.css" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.escontrela.lastmove.ui.controller.MyGamesScreenController">
  <BorderPane styleClass="app-shell">
    <top><ApplicationHeader /></top>
    <center><VBox spacing="16" styleClass="studies-workspace, my-games-workspace, tactics-library-screen"><padding><Insets top="28" right="48" bottom="32" left="48"/></padding>
      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="my-games-header, tactics-page-heading">
        <VBox spacing="3"><Label text="My Games" styleClass="my-games-title"/><HBox spacing="4"><Label text="Review, resume and organise your saved games." styleClass="my-games-support"/><Label fx:id="gameCountLabel" text="0 games" styleClass="my-games-support, tactics-suite-total"/></HBox></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox spacing="3" styleClass="my-games-player-card"><Label text="PLAYER" styleClass="eyebrow-label"/><Button fx:id="playerLabel" accessibleText="Change player whose games are shown" onAction="#choosePlayer" text="Choose player" styleClass="my-games-player-button"/></VBox>
        <Button accessibleText="Start new game" mnemonicParsing="false" onAction="#onCreateGame" styleClass="toolbar-icon-button, tactics-page-action-button" text="+"/>
      </HBox>
      <HBox alignment="TOP_LEFT" spacing="20" VBox.vgrow="ALWAYS" styleClass="tactics-library-layout">
      <VBox spacing="0" styleClass="arena-bots-card, my-games-list-card, tactics-library-card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="my-games-table-header"><Label text="Game" styleClass="my-games-header-game" HBox.hgrow="ALWAYS"/><Label text="Result" styleClass="my-games-header-result"/><Label text="Moves" styleClass="my-games-header-moves"/><Label text="Type" styleClass="my-games-header-type"/><Label text="Updated" styleClass="my-games-header-updated"/><Label text="Action" styleClass="my-games-header-action"/></HBox>
        <StackPane VBox.vgrow="ALWAYS"><ListView fx:id="gamesList" styleClass="study-library-list, my-games-list"/><Label fx:id="emptyLabel" text="Play a game to find it here." wrapText="true" styleClass="session-empty-state"/></StackPane>
      </VBox>
      <VBox spacing="16" styleClass="tactics-filter-panel">
        <VBox spacing="7"><Label text="Search &amp; filters" styleClass="tactics-filter-panel-title"/><Label text="Find the right game." styleClass="tactics-filter-panel-support"/></VBox>
        <VBox spacing="7"><Label text="Search games" styleClass="tactics-filter-section-title"/><RegexSearchControl fx:id="regexSearch" /></VBox>
        <VBox spacing="4"><TagFilterControl fx:id="tagFilter" /></VBox>
      </VBox>
      </HBox>
    </VBox></center>
    <bottom><HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-rail"><Label text="Status" styleClass="eyebrow-label"/><Label fx:id="statusLabel" text="Ready" styleClass="status-text"/><Region HBox.hgrow="ALWAYS"/></HBox></bottom>
  </BorderPane>
  <ContextualMenuPanel fx:id="contextualMenuPanel"/>
  <PlayerSelectorModal fx:id="playerSelector"/>
</StackPane>
