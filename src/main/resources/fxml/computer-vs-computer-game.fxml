<?xml version="1.0" encoding="UTF-8"?>
<?import com.escontrela.lastmove.ui.component.board.ChessBoardControl?>
<?import com.escontrela.lastmove.ui.component.header.ApplicationHeader?>
<?import com.escontrela.lastmove.ui.component.game.ComputerVsComputerSetupOverlay?>
<?import com.escontrela.lastmove.ui.component.game.GameSessionSelectorOverlay?>
<?import com.escontrela.lastmove.ui.component.game.CapturedPiecesControl?>
<?import com.escontrela.lastmove.ui.component.game.GameClockControl?>
<?import com.escontrela.lastmove.ui.component.game.ThinkingIndicatorControl?>
<?import com.escontrela.lastmove.ui.component.game.TypewriterStatusLabel?>
<?import com.escontrela.lastmove.ui.component.message.MessageBox?>
<?import com.escontrela.lastmove.ui.component.notation.MoveNotationControl?>
<?import com.escontrela.lastmove.ui.component.toolbar.ToolbarIconButton?>
<?import com.escontrela.lastmove.ui.component.profile.PlayerAvatarControl?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="root" styleClass="app-shell, computer-vs-computer-shell" stylesheets="@../css/lastmove.css" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.escontrela.lastmove.ui.controller.ComputerVsComputerScreenController">
  <BorderPane styleClass="app-shell, computer-vs-computer-shell" StackPane.alignment="TOP_LEFT">
    <top><ApplicationHeader /></top>
    <center>
      <HBox spacing="16.0" styleClass="analysis-workspace progressive-game-workspace"><padding><Insets bottom="16.0" left="20.0" right="20.0" top="8.0" /></padding>
        <StackPane fx:id="boardHost" alignment="CENTER" HBox.hgrow="ALWAYS"><ChessBoardControl fx:id="chessBoard" /></StackPane>
        <VBox prefWidth="340.0" spacing="10.0" styleClass="board-side-panel, progressive-game-side-panel">
          <VBox spacing="9.0" styleClass="progressive-player-zone"><HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="progressive-player-identity"><PlayerAvatarControl fx:id="opponentPlayerIcon" /><Label fx:id="opponentPlayerLabel" styleClass="progressive-player-name" text="Black engine" /><Circle fill="#1b1f26" radius="6.0" stroke="#69727d" strokeWidth="1.0" /><ThinkingIndicatorControl fx:id="opponentThinkingIndicator" /></HBox><GameClockControl fx:id="opponentClock" /><CapturedPiecesControl fx:id="opponentCapturedPieces" /></VBox>
          <VBox spacing="8.0" styleClass="progressive-moves-card" VBox.vgrow="ALWAYS"><MoveNotationControl fx:id="moveNotation" VBox.vgrow="ALWAYS" /><HBox alignment="CENTER" spacing="10.0" styleClass="progressive-navigation-row"><ToolbarIconButton fx:id="firstMoveButton" accessibleText="First move" darkIconResource="/images/first_page_35dp_FFFFFF.png" lightIconResource="/images/first_page_35dp_000000.png" maxWidth="Infinity" minWidth="66.0" onAction="#reviewFirstMove" prefWidth="66.0" tooltipText="First move" HBox.hgrow="ALWAYS" /><ToolbarIconButton fx:id="previousMoveButton" accessibleText="Previous move" darkIconResource="/images/arrow_left_alt_35dp_FFFFFF.png" lightIconResource="/images/arrow_left_alt_35dp_000000.png" maxWidth="Infinity" minWidth="66.0" onAction="#reviewPreviousMove" prefWidth="66.0" tooltipText="Previous move" HBox.hgrow="ALWAYS" /><ToolbarIconButton fx:id="nextMoveButton" accessibleText="Next move" darkIconResource="/images/arrow_right_alt_35dp_FFFFFF.png" lightIconResource="/images/arrow_right_alt_35dp_000000.png" maxWidth="Infinity" minWidth="66.0" onAction="#reviewNextMove" prefWidth="66.0" tooltipText="Next move" HBox.hgrow="ALWAYS" /><ToolbarIconButton fx:id="lastMoveButton" accessibleText="Live position" darkIconResource="/images/last_page_35dp_FFFFFF.png" lightIconResource="/images/last_page_35dp_000000.png" maxWidth="Infinity" minWidth="66.0" onAction="#reviewLastMove" prefWidth="66.0" tooltipText="Live position" HBox.hgrow="ALWAYS" /></HBox></VBox>
          <VBox spacing="9.0" styleClass="progressive-player-zone"><CapturedPiecesControl fx:id="humanCapturedPieces" /><GameClockControl fx:id="humanClock" /><HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="progressive-player-identity"><PlayerAvatarControl fx:id="humanPlayerIcon" /><Label fx:id="humanPlayerLabel" styleClass="progressive-player-name" text="White engine" /><Circle fill="#ffffff" radius="6.0" stroke="#69727d" strokeWidth="1.0" /><ThinkingIndicatorControl fx:id="humanThinkingIndicator" /></HBox></VBox>
          <HBox fx:id="localActions" alignment="CENTER" spacing="10.0" styleClass="progressive-actions-row"><ToolbarIconButton fx:id="takeBackButton" accessibleText="Take back the last move" darkIconResource="/images/compare_arrows_35dp_FFFFFF.png" lightIconResource="/images/compare_arrows_35dp_000000.png" disable="true" maxHeight="44.0" maxWidth="Infinity" minHeight="44.0" minWidth="0.0" mnemonicParsing="false" prefHeight="44.0" prefWidth="106.0" styleClass="arena-action-button, progressive-game-action" text="Take back" HBox.hgrow="ALWAYS" /><ToolbarIconButton fx:id="restartButton" accessibleText="Restart the game" darkIconResource="/images/refresh_35dp_FFFFFF.png" lightIconResource="/images/refresh_35dp_000000.png" maxHeight="44.0" maxWidth="Infinity" minHeight="44.0" minWidth="0.0" mnemonicParsing="false" onAction="#restart" prefHeight="44.0" prefWidth="106.0" styleClass="arena-action-button, progressive-game-action" text="Restart" HBox.hgrow="ALWAYS" /><ToolbarIconButton fx:id="resignButton" accessibleText="Stop the game" darkIconResource="/images/stop_circle_35dp_FFFFFF.png" lightIconResource="/images/stop_circle_35dp_000000.png" maxHeight="44.0" maxWidth="Infinity" minHeight="44.0" minWidth="0.0" mnemonicParsing="false" onAction="#resign" prefHeight="44.0" prefWidth="106.0" styleClass="arena-action-button, progressive-game-action, progressive-danger-action-button" text="Stop" HBox.hgrow="ALWAYS" /></HBox>
        </VBox>
      </HBox>
    </center>
    <bottom><HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="status-rail"><Label styleClass="eyebrow-label" text="Status" /><TypewriterStatusLabel fx:id="statusLabel" styleClass="status-text, typewriter-status-label" text="Choose both engines and a time control" /></HBox></bottom>
  </BorderPane>
  <MessageBox fx:id="resultMessageBox" additionalButtonText="Change engines" additionalButtonVisible="true" autoHide="false" buttonMode="ACCEPT_CANCEL" closeButtonVisible="true" dragEnabled="true" onAdditionalAction="#resetModel" />
  <ComputerVsComputerSetupOverlay fx:id="setupOverlay" />
  <GameSessionSelectorOverlay fx:id="sessionSelectorOverlay" />
</StackPane>
