<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="app-shell" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.escontrela.lastmove.ui.controller.MainWindowController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="workspace-header">
            <VBox spacing="6.0">
                <Label styleClass="eyebrow-label" text="Chess workspace" />
                <HBox alignment="BASELINE_LEFT" spacing="8.0" styleClass="app-brand">
                    <Label styleClass="app-brand-name" text="LastMove" />
                    <Label styleClass="app-brand-edition" text="Chess" />
                </HBox>
                <Label styleClass="hero-support" text="A focused desktop workspace for replaying, studying, and eventually analysing chess games." wrapText="true" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#openSetup" styleClass="ghost-button graphic-button" text="Setup" contentDisplay="LEFT">
                <graphic><ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true"><image><Image url="@../images/settings_35dp_000000.png" /></image></ImageView></graphic>
            </Button>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER_LEFT" spacing="32.0" styleClass="home-content">
            <padding><Insets bottom="64.0" left="80.0" right="80.0" top="64.0" /></padding>
            <VBox spacing="16.0" styleClass="hero-panel">
                <padding><Insets bottom="48.0" left="48.0" right="48.0" top="48.0" /></padding>
                <Label styleClass="eyebrow-label hero-eyebrow" text="Your next study session" />
                <Label styleClass="hero-title" text="Replay the decisive moment." />
                <Label styleClass="hero-copy" text="Open a PGN and step through the game with an uncluttered board and notation workspace." wrapText="true" />
                <HBox spacing="12.0">
                    <Button mnemonicParsing="false" onAction="#openPgnAnalysis" styleClass="primary-button" text="Analyse a PGN" />
                    <Button mnemonicParsing="false" onAction="#openSetup" styleClass="secondary-on-dark-button" text="Setup" />
                </HBox>
            </VBox>
            <HBox spacing="20.0">
                <VBox prefWidth="300.0" spacing="12.0" styleClass="feature-card">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                    <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true"><image><Image url="@../images/history_35dp_000000.png" /></image></ImageView>
                    <Label styleClass="card-title" text="Replay games" />
                    <Label styleClass="card-copy" text="Follow a game move by move from a single, dedicated workspace." wrapText="true" />
                </VBox>
                <VBox prefWidth="300.0" spacing="12.0" styleClass="feature-card">
                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                    <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true"><image><Image url="@../images/structure_35dp_000000.png" /></image></ImageView>
                    <Label styleClass="card-title" text="Study notation" />
                    <Label styleClass="card-copy" text="Keep the move list visible while focusing on the board position." wrapText="true" />
                </VBox>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="status-rail"><Label styleClass="status-text" text="LastMove desktop chess suite" /></HBox>
    </bottom>
</BorderPane>
