<?xml version="1.0" encoding="UTF-8"?>

<?import com.escontrela.lastmove.ui.component.context.ContextualMenuPanel?>
<?import com.escontrela.lastmove.ui.component.header.ApplicationHeader?>
<?import com.escontrela.lastmove.ui.component.message.MessageBox?>
<?import com.escontrela.lastmove.ui.component.notification.NotificationsPanel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" onContextMenuRequested="#showContextMenu" styleClass="app-shell" stylesheets="@../css/lastmove.css" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.escontrela.lastmove.ui.controller.MainWindowController">
<BorderPane styleClass="app-shell" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    <top>
        <ApplicationHeader />
    </top>
    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll-pane" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox alignment="TOP_LEFT" spacing="24.0" styleClass="tool-catalog-shell">
                        <padding><Insets bottom="40.0" left="48.0" right="48.0" top="38.0" /></padding>
                        <VBox spacing="6.0">
                            <Label fx:id="welcomeLabel" styleClass="catalog-title" text="Welcome back" />
                            <Label styleClass="catalog-support" text="What would you like to work on today?" wrapText="true" />
                        </VBox>
                        <TilePane hgap="18.0" prefColumns="4" prefTileHeight="252.0" prefTileWidth="270.0" styleClass="home-action-grid" vgap="18.0">
                            <Button accessibleText="Analyse a PGN" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openPgnAnalysis" styleClass="home-action-card, home-analysis-card"><graphic><VBox styleClass="home-card-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="7.0"><Label styleClass="home-card-title" text="Analyse a PGN" /><Label styleClass="home-card-description" text="Replay and analyse your games move by move." wrapText="true" /><Label styleClass="home-card-link" text="Start analysis  →" /></VBox></VBox></graphic></Button>
                            <Button fx:id="studiesToolButton" accessibleText="My studies" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openStudies" styleClass="home-action-card, home-studies-card"><graphic><VBox styleClass="home-card-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="7.0"><Label styleClass="home-card-title" text="My studies" /><Label styleClass="home-card-description" text="Build and revisit your chess studies." wrapText="true" /><Label styleClass="home-card-link" text="Browse studies  →" /></VBox></VBox></graphic></Button>
                            <Button fx:id="tacticsToolButton" accessibleText="Tactic suites" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openTactics" styleClass="home-action-card, home-tactics-card"><graphic><VBox styleClass="home-card-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="7.0"><Label styleClass="home-card-title" text="Tactic suites" /><Label styleClass="home-card-description" text="Create and solve tactical exercises." wrapText="true" /><Label styleClass="home-card-link" text="Start training  →" /></VBox></VBox></graphic></Button>
                            <Button accessibleText="Games" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openMyGames" styleClass="home-action-card, home-games-card"><graphic><VBox styleClass="home-card-content"><VBox spacing="3.0"><Label styleClass="home-card-title" text="Games" /><Label styleClass="home-card-description" text="Your most recently played games." /></VBox><VBox fx:id="recentGamesBox" spacing="8.0" styleClass="home-recent-games" /><Region VBox.vgrow="ALWAYS" /><Label styleClass="home-card-link" text="Open games  →" /></VBox></graphic></Button>
                        </TilePane>
                        <TilePane hgap="18.0" prefColumns="3" prefTileHeight="220.0" prefTileWidth="360.0" styleClass="home-secondary-grid" vgap="18.0">
                            <Button accessibleText="Play human vs computer" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openHumanVsComputer" styleClass="home-secondary-card, home-computer-card"><graphic><VBox styleClass="home-secondary-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="5.0"><Label styleClass="home-secondary-title" text="Play" /><Label styleClass="home-secondary-description" text="Challenge the computer at your own pace." wrapText="true" /><Label styleClass="home-card-link" text="Play now  →" /></VBox></VBox></graphic></Button>
                            <Button accessibleText="Open Knightshade Arena" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openKnightshadeArena" styleClass="home-secondary-card, home-knightshade-banner"><graphic><VBox styleClass="home-secondary-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="5.0" styleClass="knightshade-copy"><Label styleClass="knightshade-kicker" text="KNIGHTSHADE ARENA" /><Label styleClass="knightshade-title" text="Lichess bot" /><Label fx:id="arenaStatusLabel" styleClass="knightshade-arena-status" text="DISCONNECTED" /><Label fx:id="arenaAccountLabel" styleClass="knightshade-arena-activity" text="Knight Shade" /><Label fx:id="arenaActivityLabel" styleClass="knightshade-arena-activity" text="0 active · 0 challenges" /><Label styleClass="knightshade-description" text="Connect, accept challenges, and monitor live games." wrapText="true" /><Label styleClass="home-card-link knightshade-link" text="Open Arena  →" wrapText="true" /></VBox></VBox></graphic></Button>
                            <Button accessibleText="Computer versus computer" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openComputerVsComputer" styleClass="home-secondary-card, home-computer-card"><graphic><VBox styleClass="home-secondary-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="5.0"><Label styleClass="home-secondary-title" text="Computer vs Computer" /><Label styleClass="home-secondary-description" text="Create and watch a match between two chess engines." wrapText="true" /><Label styleClass="home-card-link" text="Create match  →" /></VBox></VBox></graphic></Button>
                            <Button accessibleText="Position editor" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openPositionEditor" styleClass="home-secondary-card, home-position-card"><graphic><VBox styleClass="home-secondary-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="5.0"><Label styleClass="home-secondary-title" text="Position editor" /><Label styleClass="home-secondary-description" text="Compose a position and generate a valid FEN." wrapText="true" /><Label styleClass="home-card-link" text="Open editor  →" /></VBox></VBox></graphic></Button>
                            <Button accessibleText="Training Memory" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openMemoryGame" styleClass="home-secondary-card, home-training-card"><graphic><VBox styleClass="home-secondary-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="5.0"><Label styleClass="home-secondary-title" text="Training Memory" /><Label styleClass="home-secondary-description" text="Memorize real game positions and rebuild the hidden pieces. 3 min." wrapText="true" /><Label styleClass="home-card-link" text="Start session  →" /></VBox></VBox></graphic></Button>
                            <Button accessibleText="Training Storm" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#openStormGame" styleClass="home-secondary-card, home-storm-card"><graphic><VBox styleClass="home-secondary-content"><Region VBox.vgrow="ALWAYS" /><VBox spacing="5.0"><Label styleClass="home-secondary-title" text="Training Storm" /><Label styleClass="home-secondary-description" text="Tácticas rápidas · 3 min" wrapText="true" /><Label styleClass="home-card-link" text="Start session  →" /></VBox></VBox></graphic></Button>
                        </TilePane>
                    </VBox>
                </content>
            </ScrollPane>
            <NotificationsPanel fx:id="notificationsPanel" />
            <MessageBox fx:id="startupMessageBox" acceptText="Open PGN analysis" autoHide="true" buttonMode="ACCEPT_CANCEL" cancelText="Not now" cardWidth="460.0" contentPadding="20.0" contentSpacing="12.0" dragEnabled="true" message="Would you like to open the PGN analysis workspace and replay a recorded game?" title="Welcome to LastMove Chess" />
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="status-rail">
            <Label styleClass="eyebrow-label" text="Status" />
            <Label styleClass="status-text" text="Ready to choose a chess workspace" />
            <Region HBox.hgrow="ALWAYS" />
            <ImageView fx:id="statusBrandLogo" fitHeight="20.0" fitWidth="96.0" preserveRatio="true" smooth="true" styleClass="status-brand-logo">
                <image><Image url="@../images/lastmove-chess-logo.png" /></image>
            </ImageView>
        </HBox>
    </bottom>
</BorderPane>
    <ContextualMenuPanel fx:id="contextualMenuPanel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
</AnchorPane>
