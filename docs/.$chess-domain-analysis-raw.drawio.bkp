        <mxCell id="tacticExercise" value="&lt;b&gt;TacticExercise&lt;/b&gt; (entidad)&lt;br&gt;&lt;hr&gt;− id: TacticExerciseId&lt;br&gt;− title: String&lt;br&gt;− solution: AnalysisContent&lt;br&gt;− createdAt / updatedAt: Instant&lt;br&gt;&lt;hr&gt;+ solverColor(): PieceColor&lt;br&gt;+ hasSolution(): boolean&lt;br&gt;+ rename(title) / touch()&lt;br&gt;&lt;br&gt;El color se deriva de initialPosition.activeColor; la orientación visual no lo altera." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ed7d31;fontColor=#1f2937;align=left;spacingLeft=10;spacingTop=7;" parent="tacticsPanel" vertex="1">
