        <mxCell id="tacticRepository" value="&lt;b&gt;TacticRepository&lt;/b&gt; «interface»&lt;br&gt;&lt;hr&gt;+ save(suite): TacticSuite&lt;br&gt;+ findByIdAndOwner / findAllByOwner&lt;br&gt;+ deleteByIdAndOwner / deleteByOwner&lt;br&gt;+ moveSuiteToIndex(...)&lt;br&gt;&lt;hr&gt;Persistencia SQLite: suites, ejercicios y tactic_solution_nodes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#ed7d31;fontColor=#1f2937;align=left;spacingLeft=10;spacingTop=7;" parent="tacticsPanel" vertex="1">
