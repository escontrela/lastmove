        <mxCell id="tacticSuite" value="&lt;b&gt;TacticSuite&lt;/b&gt; (agregado raíz)&lt;br&gt;&lt;hr&gt;− id: TacticSuiteId&lt;br&gt;− ownerId: PlayerId&lt;br&gt;− title / description&lt;br&gt;− exercises: List&lt;TacticExercise&gt; (ordenados)&lt;br&gt;− createdAt / updatedAt: Instant&lt;br&gt;&lt;hr&gt;+ addExercise / removeExercise / moveExercise&lt;br&gt;+ rename(title) / setDescription(desc)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ed7d31;fontColor=#1f2937;align=left;spacingLeft=10;spacingTop=7;" parent="tacticsPanel" vertex="1">
